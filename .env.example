# Environment variables for the frontend
VITE_CLERK_PUBLISHABLE_KEY=clerk_publishable_key
VITE_WAITLIST_MODE=true
VITE_BASE_URL=http://localhost:3000

## Server URL (required in production for Stripe checkout redirects)
SERVER_URL=https://your-production-domain.com

# Environment variables for the server side code

## Environment variables for Clerk
CLERK_SECRET_KEY=clerk_secret_key
CLERK_WEBHOOK_SECRET=clerk_webhook_secret

## Environment variables for Resend
RESEND_API_KEY=resend_api_key
RESEND_SEGMENT_ALL_ID=all-segment-id
RESEND_SEGMENT_PAID_ID=paid-segment-id
RESEND_SEGMENT_FREE_ID=free-segment-id
RESEND_TOPIC_ANNOUNCEMENTS_ID=announcements-topic-id
RESEND_TOPIC_RELEASES_ID=releases-topic-id
RESEND_TOPIC_ALERTS_ID=alerts-topic-id

## API gateway (../preflight/apps/api)
# Public URL shown in docs and code samples
VITE_API_GATEWAY_URL=https://api.preflightapi.io
# Server-side URL (Railway private network in production)
GATEWAY_URL=http://localhost:8080
# Must match the gateway's INTERNAL_API_SECRET
GATEWAY_INTERNAL_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
# Postgres holding the gateway schema (usage analytics are read directly)
GATEWAY_DATABASE_URL=postgres://postgres:postgres@localhost:5432/preflightapi
# Must match the gateway's DEMO_USER_ID
DEMO_USER_ID=demo

## Backend health checks (the gateway URL works; it passes /health through)
PREFLIGHT_API_BASE_URL=http://localhost:8080
PREFLIGHT_API_GATEWAY_SECRET=

# Environment variables for Stripe
STRIPE_SECRET_KEY=stripe_secret_key
STRIPE_WEBHOOK_SECRET=stripe_webhook_secret
STRIPE_PRIVATE_PRICE_ID=stripe_private_price_id
STRIPE_COMMERCIAL_PRICE_ID=stripe_commercial_price_id

# Admin dashboard
ADMIN_EMAILS=admin@example.com
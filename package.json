{
  "name": "preflightapi.frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run sync-api || echo [sync-api] Skipped, using existing spec",
    "dev": "vite dev --port 3000",
    "prebuild": "npm run lint && npm run sync-api || echo [sync-api] Skipped, using existing spec",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint --fix",
    "format": "prettier",
    "check": "prettier --write . && eslint --fix",
    "start": "node .output/server/index.mjs",
    "sync-api": "npm run update-api-spec && npm run generate-api-types",
    "update-api-spec": "node scripts/update-api-spec.mjs",
    "generate-api-types": "openapi-typescript docs/preflightapi_swagger.json -o src/generated/api.ts --root-types --root-types-no-schema-prefix"
  },
  "dependencies": {
    "@azure/identity": "^4.13.0",
    "@clerk/clerk-react": "^5.49.0",
    "@clerk/tanstack-react-start": "^0.29.1",
    "@clerk/themes": "^2.4.51",
    "@react-email/components": "^1.0.7",
    "@react-email/render": "^2.0.4",
    "@t3-oss/env-core": "^0.13.8",
    "@tailwindcss/vite": "^4.0.6",
    "@tanstack/match-sorter-utils": "^8.19.4",
    "@tanstack/react-devtools": "^0.7.0",
    "@tanstack/react-form": "^1.0.0",
    "@tanstack/react-query": "^5.66.5",
    "@tanstack/react-query-devtools": "^5.84.2",
    "@tanstack/react-router": "^1.132.0",
    "@tanstack/react-router-devtools": "^1.132.0",
    "@tanstack/react-router-ssr-query": "^1.131.7",
    "@tanstack/react-start": "^1.132.0",
    "@tanstack/react-table": "^8.21.2",
    "@tanstack/router-plugin": "^1.132.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.561.0",
    "next-themes": "^0.4.6",
    "nitro": "npm:nitro-nightly@latest",
    "pino": "^10.3.1",
    "radix-ui": "^1.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^2.15.4",
    "resend": "^6.9.1",
    "shiki": "^3.22.0",
    "sonner": "^2.0.7",
    "stripe": "^20.3.1",
    "svix": "^1.85.0",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.0.6",
    "three": "^0.182.0",
    "tw-animate-css": "^1.3.6",
    "vite-tsconfig-paths": "^6.0.2",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.3.0",
    "@tanstack/devtools-vite": "^0.3.11",
    "@tanstack/eslint-config": "^0.3.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.182.0",
    "@vitejs/plugin-react": "^5.0.4",
    "jsdom": "^27.0.0",
    "openapi-typescript": "^7.10.1",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.5.3",
    "typescript": "^5.7.2",
    "vite": "^7.1.7",
    "vitest": "^3.0.5",
    "web-vitals": "^5.1.0"
  }
}
